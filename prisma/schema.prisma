// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int           @id @default(autoincrement())
  email                String        @unique
  phone                String        @unique
  telegram             String        @unique
  name                 String
  avatar               String?
  surname              String
  password             String
  patronymic           String?
  dateBirth            DateTime      @default(now())
  education            String?
  courses              String?
  dateStart            DateTime      @default(now())
  department           Department?   @relation("DepartmentMebers", fields: [departmentId], references: [id])
  departmentId         Int?
  post                 String
  grade                Grade         @default(INTERN)
  dateAttestation      DateTime      @default(now())
  timeZone             String        @default("МСК")
  role                 Role          @default(EMPLOYEE)
  events               Event[]
  eventsResponsible    Event[]       @relation("EventsResponsible")
  certificates         Certificate[]
  headOfDepartment     Department?   @relation("DepartmentHead")
  resetPasswordToken   String?       @unique
  resetPasswordExpires DateTime?
}

model Certificate {
  id      Int    @id @default(autoincrement())
  name    String
  path    String @unique
  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId Int
}

model Department {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  members      User[]      @relation("DepartmentMebers")
  events       Event[]
  head         User?       @relation("DepartmentHead", fields: [headId], references: [id])
  headId       Int?        @unique
  competence   Competence? @relation(fields: [competenceId], references: [id])
  competenceId Int?        @unique
  documents    Document[]  @relation("DepartmentDocuments")
}

model Event {
  id           Int        @id @default(autoincrement())
  name         String
  type         EventType  @default(ATTESTATION)
  dateStart    DateTime
  dateEnd      DateTime
  result       Json
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
  members      User[]
  responsibles User[]     @relation("EventsResponsible")
  link         String
}

model Document {
  id           Int         @id @default(autoincrement())
  name         String
  path         String
  pinned       Boolean     @default(false)
  department   Department? @relation("DepartmentDocuments", fields: [departmentId], references: [id])
  departmentId Int?
}

model Competence {
  id         Int         @id @default(autoincrement())
  info       Json
  department Department?
}

enum Role {
  EMPLOYEE
  ADMIN_DEPARTMENT
  ADMIN
}

enum Grade {
  INTERN
  JUNIOR
  MIDDLE
  MIDDLE_PLUS
  SENIOR
}

enum EventType {
  ATTESTATION
}
